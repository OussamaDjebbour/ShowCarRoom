# Supabase — browser-safe public client keys only.
# Vite receives these from the connected environment through vite.config.ts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-public-key

# Local Vite equivalents are also supported when running outside Vercel.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The service role key is NEVER used in the frontend — it bypasses RLS.
# It is only for server-side / edge-function code and is already set in
# the hosted environment. Do NOT add it to client code.
