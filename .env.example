# Supabase — public client keys (safe to expose to the browser).
# These are pre-populated in .env for this project. Copy this file to .env
# and fill in the values for a new project if you fork the repo.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The service role key is NEVER used in the frontend — it bypasses RLS.
# It is only for server-side / edge-function code and is already set in
# the hosted environment. Do NOT add it to client code.
